# JWT Configuration
JWT_SECRET=change_me_to_a_random_secret_at_least_32_chars
JWT_EXPIRES_IN=24h

# Application Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=daydream_portal
POSTGRES_USER=daydream_user
POSTGRES_PASSWORD=daydream_password
POSTGRES_SSL=false

# PostgreSQL Read-Only User (for admin console)
POSTGRES_READONLY_USER=readonly_user
POSTGRES_READONLY_PASSWORD=readonly_secure_pass_change_me

# Frontend Configuration (for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
